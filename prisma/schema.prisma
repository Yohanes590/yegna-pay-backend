// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Users {
  id                      String     @id @default(uuid())
  full_name               String
  email                   String     @unique
  password                String?
  avatar_url              String?
  Provider                String?
  account_status          String
  payment_plan            String
  verified                Boolean
  request_available       Int
  free_requests_remaining Int        @default(200)
  free_requests_used      Int        @default(0)
  paid_requests_balance   Int        @default(0)
  paid_requests_used      Int        @default(0)
  projects                Projects[]
  revenues                Revenue[]
}



model Admin {
  id String @id @default(uuid())
  user_name String
  user_email String
  password String
  user_role String
  user_permission Json
  is_active Boolean
  two_factor_enabled Boolean
  author_name String
  authorized_date String
  last_login String
  Projects Projects[]
}

model Projects {
  id String @id @default(uuid())
  project_name String 
  api_sec_key String
  call_back_url String
  project_description String
  user_Id String 
  adminID String?
  user Users @relation(fields: [user_Id] ,references: [id] ,onDelete: Cascade)
  Admin_projects Admin? @relation(fields: [adminID] , references: [id] ,onDelete: Cascade)
  ProjectBalance String 
  transactions Transaction[]
  qrReceiptImages QrReceiptImage[]
  before_expires String?
  receiver_name String?
  /// When true: match receiver name, amount, and eligibility date. When false: amount + duplicate only.
  detail_verification Boolean @default(true)
}



model Transaction {
  id String @id @default(uuid())
  transaction_id String @unique
  transaction_amount Decimal
  created_at DateTime @default(now())
  method String
  transaction_status String
  from String
  to String 
  currency String  @default("ETB")
  projectId String
  projects Projects @relation(fields: [projectId] , references: [id] , onDelete: Cascade)
  risk_score Int
  Logs TransactionLog[]
}

model TransactionLog {
  id String @id @default(uuid())
  transaction_id String?
  transactions Transaction? @relation(fields: [transaction_id], references: [transaction_id] , onDelete: Cascade)
  event String        
  message String      
  transaction_status String  
  transaction_bank String   
  created_at DateTime @default(now())
}

model QrReceiptImage {
  id                     String    @id @default(uuid())
  projectId              String
  projects               Projects  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl               String
  cloudinaryPublicId     String?
  localFilePath          String?
  mimeType               String    @default("image/png")
  status                 String
  extractedTransactionId String?
  qrContent              String?
  transactionAmount      Decimal?
  currency               String    @default("ETB")
  bankName               String    @default("UNKNOWN")
  receiptDate            String?
  failureReason          String?
  verifiedAt             DateTime?
  createdAt              DateTime  @default(now())

  @@index([projectId, status, createdAt])
}

model PricingTable {
  id String @id @default(uuid())
  price_name String
  amount Int
  features Json[]
  requests Int
}

model DatabaseCronJob {
  id String @id @default(uuid()) @unique
  CronJob String 
}



model Revenue {
  id            String   @id @default(uuid())
  payer_name    String
  paid_requests Int      
  currency      String   @default("ETB")
  time_stamp    DateTime @default(now())
  user_id       String
  amount        Decimal? @default(0)
  status        String   @default("verified")
  method        String   @default("CBE")
  user          Users    @relation(fields: [user_id], references: [id], onDelete: Cascade) 
}


model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}
